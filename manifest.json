{
  "manifest_version": 2,
  "name": "Auto Stash Tabs",
  "version": "0.1.0",
  "description": "Automatically stashes idle tabs to bookmarks when too many tabs are open (Tab Stash compatible).",
  "homepage_url": "https://github.com/krzentner/auto-stash-tabs",
  "browser_specific_settings": {
    "gecko": {
      "id": "auto-stash-tabs@krz.is",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["tabs", "tabGroups", "bookmarks", "storage", "alarms"],
  "background": {
    "scripts": ["common.js", "background.js"],
    "persistent": true
  },
  "options_ui": {
    "page": "options.html"
  },
  "browser_action": {
    "default_title": "Auto Stash Tabs",
    "default_popup": "popup.html",
    "default_icon": "icons/icon.svg"
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  }
}
